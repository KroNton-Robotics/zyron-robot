<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="zyron">

  <!-- ─── Parameters ──────────────────────────────────────────── -->
  <xacro:arg name="is_sim" default="True"/>
  <xacro:arg name="mcu_serial_port" default="/dev/ttyUSB0"/>

  <!-- Robot dimensions (update to match your hardware) -->
  <xacro:property name="base_length"     value="0.290"/>
  <xacro:property name="base_width"      value="0.210"/>
  <xacro:property name="base_height"     value="0.080"/>
  <xacro:property name="wheel_radius"    value="0.033"/>
  <xacro:property name="wheel_width"     value="0.025"/>
  <xacro:property name="wheel_sep"       value="0.245"/>  <!-- centre-to-centre: inner wheel face is 5mm outside body wall -->
  <xacro:property name="caster_radius"   value="0.015"/>
  <xacro:property name="wheel_x_from_back" value="0.06"/>  <!-- wheels are 6cm from the back edge -->
  <!-- wheel x in base_link frame: back edge + offset -->
  <xacro:property name="wheel_x" value="${-base_length/2 + wheel_x_from_back}"/>

  <!-- Tower on top of base at the back (drive-wheel side), for lidar mount -->
  <xacro:property name="tower_length"    value="0.120"/>
  <xacro:property name="tower_width"     value="0.200"/>
  <xacro:property name="tower_height"    value="0.055"/>

  <!-- ─── base_footprint ─────────────────────────────────────── -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ─── base_link ──────────────────────────────────────────── -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.00421" ixy="0" ixz="0" iyy="0.00754" iyz="0" izz="0.01068"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="light_grey">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- ─── Tower (lidar mount platform, back of robot) ────────── -->
  <link name="tower_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <!-- Solid box inertia: I = m/12*(a²+b²) -->
      <inertia ixx="0.000327" ixy="0" ixz="0"
               iyy="0.000733" iyz="0"
               izz="0.000983"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${tower_length} ${tower_width} ${tower_height}"/>
      </geometry>
      <material name="light_grey">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${tower_length} ${tower_width} ${tower_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- Tower sits on top of the base, flush with the back (-x) edge -->
  <!-- x: back edge of base + half tower length = -base_length/2 + tower_length/2 -->
  <!-- z: top of base + half tower height        =  base_height/2 + tower_height/2 -->
  <joint name="tower_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="tower_link"/>
    <origin xyz="${-base_length/2 + tower_length/2} 0 ${base_height/2 + tower_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- ─── Lidar (mounted on top of tower, centred) ────────────── -->
  <!-- Dimensions: RPLidar A1 approximate — adjust to your model   -->
  <xacro:property name="lidar_radius"  value="0.038"/>  <!-- 76mm diameter -->
  <xacro:property name="lidar_height"  value="0.041"/>  <!-- 41mm tall     -->

  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.17"/>
      <!-- Solid cylinder: Ixx=Iyy=m/12*(3r²+h²), Izz=m/2*r² -->
      <inertia ixx="0.000086" ixy="0" ixz="0"
               iyy="0.000086" iyz="0"
               izz="0.000123"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
  </link>

  <!-- Lidar sits centred on top of the tower                         -->
  <!-- z = tower_height/2 (top of tower) + lidar_height/2 (centre)   -->
  <joint name="lidar_joint" type="fixed">
    <parent link="tower_link"/>
    <child  link="lidar_link"/>
    <origin xyz="0 0 ${tower_height/2 + lidar_height/2}" rpy="0 0 0"/>
  </joint>

<link name="imu_link">
  <inertial>
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    <mass value="0.0"/>
    <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
  </inertial>
  <visual name="">
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    <geometry>
      <box size="0.01 0.01 0.01"/>
    </geometry>
    <material name="">
      <color rgba="1.0 0.0 0.0 1.0"/>
      <texture filename=""/>
    </material>
  </visual>
  <collision>
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    <geometry>
      <box size="0.01 0.01 0.01"/>
    </geometry>
  </collision>
</link>

<joint name="imu_joint" type="fixed">
  <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  <parent link="base_link"/>
  <child link="imu_link"/>
  <axis xyz="0.0 0.0 0.0"/>
  <limit lower="0.0" upper="0.0" effort="0.0" velocity="0.0"/>
</joint>



  <!-- ─── Wheel macro ─────────────────────────────────────────── -->
  <xacro:macro name="wheel" params="name y_offset">
    <link name="${name}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="1.4e-5" ixy="0" ixz="0" iyy="1.4e-5" iyz="0" izz="2.6e-5"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="dark_grey">
          <color rgba="0.2 0.2 0.2 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${name}"/>
      <origin xyz="${wheel_x} ${y_offset} ${-base_height/2}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="wheel_left"  y_offset="${ wheel_sep/2}"/>
  <xacro:wheel name="wheel_right" y_offset="${-wheel_sep/2}"/>

  <!-- ─── Caster wheel ────────────────────────────────────────── -->
  <link name="caster_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
  </link>

  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="caster_wheel"/>
    <origin xyz="${base_length/2 - caster_radius} 0 ${-base_height/2 - caster_radius + wheel_radius - wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ─── ros2_control block ──────────────────────────────────── -->
  <xacro:unless value="$(arg is_sim)">
    <ros2_control name="ZyronSystem" type="system">
      <hardware>
        <plugin>zyron_control/ZyronInterface</plugin>
        <param name="port">$(arg serial_port)</param>
        <param name="baud_rate">115200</param>

      </hardware>

      <joint name="wheel_left_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="wheel_right_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <sensor name="imu">
        <state_interface name="orientation.x"/>
        <state_interface name="orientation.y"/>
        <state_interface name="orientation.z"/>
        <state_interface name="orientation.w"/>
        <state_interface name="angular_velocity.x"/>
        <state_interface name="angular_velocity.y"/>
        <state_interface name="angular_velocity.z"/>
        <state_interface name="linear_acceleration.x"/>
        <state_interface name="linear_acceleration.y"/>
        <state_interface name="linear_acceleration.z"/>
      </sensor>
    </ros2_control>
  </xacro:unless>

  <!-- Simulation ros2_control block (Gazebo) -->
  <xacro:if value="${$(arg is_sim)}">
    <ros2_control name="ZyronSimSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <joint name="wheel_left_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="wheel_right_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>
  </xacro:if>

</robot>
