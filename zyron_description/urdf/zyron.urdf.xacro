<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="zyron">

  <!-- ─── Parameters ──────────────────────────────────────────── -->
  <xacro:arg name="is_sim" default="True"/>
  <xacro:arg name="serial_port" default="/dev/ttyUSB0"/>

  <!-- Robot dimensions (update to match your hardware) -->
  <xacro:property name="base_length"     value="0.30"/>
  <xacro:property name="base_width"      value="0.20"/>
  <xacro:property name="base_height"     value="0.10"/>
  <xacro:property name="wheel_radius"    value="0.033"/>
  <xacro:property name="wheel_width"     value="0.025"/>
  <xacro:property name="wheel_sep"       value="0.17"/>   <!-- centre-to-centre -->
  <xacro:property name="caster_radius"   value="0.015"/>

  <!-- ─── base_footprint ─────────────────────────────────────── -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ─── base_link ──────────────────────────────────────────── -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0083" ixy="0" ixz="0" iyy="0.0208" iyz="0" izz="0.0250"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.2 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
  </link>
<link name="imu_link">
  <inertial>
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    <mass value="0.0"/>
    <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
  </inertial>
  <visual name="">
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    <geometry>
      <box size="0.1 0.1 0.1"/>
    </geometry>
    <material name="">
      <color rgba="1.0 0.0 0.0 1.0"/>
      <texture filename=""/>
    </material>
  </visual>
  <collision>
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    <geometry>
      <box size="0.1 0.1 0.1"/>
    </geometry>
  </collision>
</link>

<joint name="imu_joint" type="fixed">
  <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  <parent link="base_link"/>
  <child link="imu_link"/>
  <axis xyz="0.0 0.0 0.0"/>
  <limit lower="0.0" upper="0.0" effort="0.0" velocity="0.0"/>
</joint>



  <!-- ─── Wheel macro ─────────────────────────────────────────── -->
  <xacro:macro name="wheel" params="name y_offset">
    <link name="${name}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="1.4e-5" ixy="0" ixz="0" iyy="1.4e-5" iyz="0" izz="2.6e-5"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="dark_grey">
          <color rgba="0.2 0.2 0.2 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${name}"/>
      <origin xyz="0 ${y_offset} ${-base_height/2}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="wheel_left"  y_offset="${ wheel_sep/2}"/>
  <xacro:wheel name="wheel_right" y_offset="${-wheel_sep/2}"/>

  <!-- ─── Caster wheel ────────────────────────────────────────── -->
  <link name="caster_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.02"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
  </link>

  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="caster_wheel"/>
    <origin xyz="${base_length/2 - caster_radius} 0 ${-base_height/2 - caster_radius + wheel_radius - wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ─── ros2_control block ──────────────────────────────────── -->
  <xacro:unless value="$(arg is_sim)">
    <ros2_control name="ZyronSystem" type="system">
      <hardware>
        <plugin>zyron_control/ZyronInterface</plugin>
        <param name="port">$(arg serial_port)</param>
        <param name="baud_rate">460800</param>
        <param name="left_counts_per_rev">228.0</param>
        <param name="right_counts_per_rev">224.0</param>
        <param name="max_speed_rad_s">20.94</param>
        <param name="start_threshold_rad_s">0.5</param>
        <param name="stop_threshold_rad_s">0.2</param>
        <param name="left_pwm_min">60</param>
        <param name="right_pwm_min">60</param>
        <param name="pwm_max">255</param>
        <param name="left_kp">1.0</param>
        <param name="left_ki">2.0</param>
        <param name="right_kp">1.0</param>
        <param name="right_ki">2.0</param>
        <param name="max_acceleration_rad_s2">15.0</param>
        <param name="velocity_filter_tau_s">0.1</param>
        <param name="firmware_watchdog_ms">200</param>
        <param name="startup_timeout_ms">10000</param>
        <param name="state_timeout_ms">250</param>
        <param name="imu_timeout_ms">250</param>
      </hardware>
      <joint name="wheel_left_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="wheel_right_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <sensor name="imu">
        <state_interface name="orientation.x"/>
        <state_interface name="orientation.y"/>
        <state_interface name="orientation.z"/>
        <state_interface name="orientation.w"/>
        <state_interface name="angular_velocity.x"/>
        <state_interface name="angular_velocity.y"/>
        <state_interface name="angular_velocity.z"/>
        <state_interface name="linear_acceleration.x"/>
        <state_interface name="linear_acceleration.y"/>
        <state_interface name="linear_acceleration.z"/>
      </sensor>
    </ros2_control>
  </xacro:unless>

  <!-- Simulation ros2_control block (Gazebo) -->
  <xacro:if value="${$(arg is_sim)}">
    <ros2_control name="ZyronSimSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <joint name="wheel_left_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="wheel_right_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>
  </xacro:if>

</robot>
